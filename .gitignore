# ──────────────────────────────────────
# Heritage Club — .gitignore
# ──────────────────────────────────────

# --- Environment variables ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# --- Dependencies ---
node_modules/
.pnpm/
.pnpm-store/
.pnpm-debug.log*

# --- Build output ---
.next/
out/
build/
dist/

# --- TypeScript ---
tsconfig.tsbuildinfo
*.tsbuildinfo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# --- v0 sandbox internal files ---
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# --- Vercel ---
.vercel/

# --- Coverage ---
coverage/
.nyc_output/

# --- Local MongoDB data ---
.data/

# --- Large media assets (exceeds GitHub 100MB limit) ---
public/vic (1).mp4
public/vic2 (1).mp4
public/vic2 (2).mp4
