# MongoDB connection string (add your own credentials)
MONGODB_URI=mongodb://localhost:27017/heritage-club

# Secret used to sign session JWTs (use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-secret-string

# Public site URL
NEXT_PUBLIC_APP_URL=https://heritage.damzynextgen.app

# Email Configuration (SMTP) - Required for password reset and other emails
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@damzynextgen.app
SMTP_PASS=your-email-password-or-app-specific-password

# Paystack payments (add your own keys later)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Transaction currency supported by your Paystack account (NGN, GHS, ZAR, USD, KES)
PAYSTACK_CURRENCY=NGN

# Staff signup access codes. Signup for each staff role is DISABLED until its
# code is set. Share these only with people you want to grant access to.
EDUCATOR_INVITE_CODE=
ADMIN_SETUP_CODE=
